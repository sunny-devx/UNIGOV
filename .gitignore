# Root .gitignore for UNIGOV Monorepo

# Operating System files
.DS_Store
Thumbs.db
*.swp
*.swo

# IDE and Editor files
.idea/
.vscode/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Java / Maven / Backend
backend/target/
target/
*.class
*.jar
*.war
*.ear

# Environment files
.env
.env.local
.env.*.local

# Database files
postgres_data/
*.db
